{
  "ngspice_native": {
    "category": "electronic-simulation",
    "source": "https://github.com/apexin-ai/ASI-Bench/tree/main/scripts/mcp/engineering",
    "availability": "repository_adapter",
    "notes": "Native engine jobs; build scripts/mcp/engineering/Dockerfile.eda; see docs/mcp/engineering.md. Existing third-party catalog contract stays separate.",
    "server": {
      "command": "/opt/venv/bin/python",
      "args": [
        "/opt/engineering-mcp/server.py",
        "--backend",
        "ngspice"
      ],
      "cwd": "/workspace",
      "env": {
        "ENGINEERING_MCP_WORKSPACE": "/workspace"
      },
      "sandbox": {
        "deployment": "instance",
        "startup_timeout_seconds": 120
      }
    }
  },
