{
  "schema_version": 1,
  "servers": {
    "comsol": {
      "category": "multiphysics",
      "source": "https://github.com/Suzy-Sa/COMSOL-Multiphysics-MCP",
      "prerequisites": ["Clone and install the server", "Licensed local COMSOL installation", "Set the repository cwd and matching Python executable"],
      "server": {"command": "/path/to/comsol-mcp/.venv/bin/python", "args": ["-m", "comsol_agent_mcp.server"], "cwd": "/path/to/comsol-mcp"}
    },
    "openfoam": {
      "category": "cfd",
      "source": "https://github.com/webworn/openfoam-mcp-server",
      "prerequisites": ["Build the C++ server from source", "Install OpenFOAM 12 and configure its environment"],
      "server": {"command": "/path/to/openfoam-mcp-server/build/openfoam-mcp-server", "args": []}
    },
    "matlab": {
      "category": "scientific-computing",
      "source": "https://github.com/matlab/matlab-mcp-server",
      "prerequisites": ["Install MATLAB R2021a or later", "Download or build the official matlab-mcp-server binary"],
      "server": {"command": "/path/to/matlab-mcp-server", "args": ["--matlab-display-mode=nodesktop", "--disable-telemetry=true"]}
    },
    "simulink": {
      "category": "system-simulation",
      "source": "https://github.com/matlab/simulink-agentic-toolkit",
      "prerequisites": ["Install MATLAB and Simulink", "Install the MathWorks Simulink Agentic Toolkit", "Use the official MATLAB MCP server as the MCP bridge; the toolkit itself is complementary agent tooling"],
      "server": {"command": "/path/to/matlab-mcp-server", "args": ["--matlab-display-mode=nodesktop", "--disable-telemetry=true"]}
    },
    "mworks": {
      "category": "system-engineering",
      "source": "https://github.com/ACupOfHim/mworks-mcp-server",
      "prerequisites": ["Install MWORKS and make its automation API available", "Install uv"],
      "server": {"command": "uvx", "args": ["mworks-mcp-server"]}
    },
    "pynite": {
      "category": "structural-analysis",
      "source": "https://github.com/admindev-buildwellai/MCP-Pynite",
      "prerequisites": ["Clone and install MCP-Pynite with visualization dependencies"],
      "server": {"command": "/path/to/mcp-pynite/.venv/bin/python", "args": ["-m", "pynite_mcp.main"], "env": {"TRANSPORT": "stdio"}}
    },
    "energyplus": {
      "category": "building-energy",
      "source": "https://github.com/LBNL-ETA/EnergyPlus-MCP",
      "prerequisites": ["Clone EnergyPlus-MCP", "Build its energyplus-mcp-dev Docker image"],
      "server": {"command": "docker", "args": ["run", "--rm", "-i", "-v", "/path/to/EnergyPlus-MCP:/workspace", "-w", "/workspace/energyplus-mcp-server", "energyplus-mcp-dev", "uv", "run", "python", "-m", "energyplus_mcp_server.server"]}
    },
    "text2sim": {
      "category": "discrete-event-simulation",
      "source": "https://github.com/IamCatoBot/text2sim-MCP-server",
      "prerequisites": ["Clone the server", "Install uv and run uv sync"],
      "server": {"command": "uv", "args": ["--directory", "/path/to/text2sim-MCP-server", "run", "python", "-m", "mcp_server"]}
    },
    "netlogo": {
      "category": "agent-based-modeling",
      "source": "https://github.com/Razee4315/NetLogo-MCP",
      "prerequisites": ["Install netlogo-mcp", "Install NetLogo 7 and a compatible JDK", "Set NETLOGO_HOME and JAVA_HOME"],
      "server": {"command": "netlogo-mcp", "args": [], "env": {"NETLOGO_HOME": "/path/to/NetLogo", "JAVA_HOME": "/path/to/jdk"}}
    },
    "afsim": {
      "category": "military-simulation",
      "source": "https://github.com/Yookio-Z/AFSIM_MCP",
      "prerequisites": ["Windows host", "Licensed local AFSIM installation", "Clone and install the MCP server"],
      "server": {"command": "/path/to/afsim-mcp/.venv/Scripts/python.exe", "args": ["-m", "afsim_mcp.server"], "cwd": "/path/to/afsim-mcp"}
    },
    "blender": {
      "category": "3d-modeling",
      "source": "https://github.com/ahujasid/blender-mcp",
      "prerequisites": ["Install Blender 3.0+", "Install uv", "Install and enable the Blender MCP addon"],
      "server": {"command": "uvx", "args": ["blender-mcp"]}
    },
    "freecad": {
      "category": "cad",
      "source": "https://github.com/bonninr/freecad_mcp",
      "prerequisites": ["Install FreeCAD", "Install the freecad_mcp addon", "Replace the Python and bridge paths"],
      "server": {"command": "/path/to/python", "args": ["/path/to/freecad_mcp/src/freecad_bridge.py"]}
    },
    "autocad": {
      "category": "cad",
      "source": "https://github.com/U-C4N/Autocad-MCP",
      "prerequisites": ["Install autocad-mcp-pro", "Set ALLOWED_PATHS", "Use ezdxf headless or install AutoCAD for COM mode"],
      "server": {"command": "autocad-mcp", "args": [], "env": {"AUTOCAD_MCP_BACKEND": "auto", "ALLOWED_PATHS": "/path/to/allowed/cad/files", "DISCOVERY_MODE": "search"}}
    },
    "fusion360": {
      "category": "cad",
      "source": "https://github.com/ArchimedesCrypto/fusion360-mcp-server",
      "prerequisites": ["Install Autodesk Fusion 360", "Clone and install the server", "Configure the Fusion add-in/bridge"],
      "server": {"command": "/path/to/python", "args": ["/path/to/fusion360-mcp-server/src/main.py", "--mcp"]}
    },
    "sketchup": {
      "category": "cad",
      "source": "https://github.com/BearNetwork-BRNKC/SketchUp-MCP",
      "prerequisites": ["Install SketchUp", "Install and enable its MCP extension", "Install uv"],
      "server": {"command": "uvx", "args": ["sketchup-mcp"]}
    },
    "pubchem": {
      "category": "chemistry-data",
      "source": "https://github.com/cyanheads/pubchem-mcp-server",
      "prerequisites": ["Network access to the public hosted service, or self-host the server"],
      "server": {"url": "https://pubchem.caseyjhand.com/mcp"}
    },
    "gns3": {
      "category": "network-simulation",
      "source": "https://github.com/Wael-Rd/gns3-mcp-server",
      "prerequisites": ["Clone and install the GNS3 MCP server", "Run GNS3 on its configured API endpoint"],
      "server": {"command": "/path/to/gns3-mcp-server/run.sh", "args": [], "cwd": "/path/to/gns3-mcp-server"}
    }
  }
}
