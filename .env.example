# ASI-Bench — environment variable template
# Copy to .env and fill in your own keys (.env is gitignored and never committed).
# You only need the keys for the agent(s) and Judge provider you actually use.

# ── Credentials for the agent under test (set the one matching your --agent) ──
# direct_llm / litellm over the OpenAI protocol
OPENAI_API_KEY=
# OpenRouter (direct_llm with openrouter/<provider>/<model>)
OPENROUTER_API_KEY=
# Anthropic direct (direct_llm with the anthropic protocol; claude_code_cli uses your
# local `claude` login and does not need this)
ANTHROPIC_API_KEY=
# Google Gemini
GEMINI_API_KEY=
# DeepSeek (default backend for codewhale)
DEEPSEEK_API_KEY=

# ── Optional LLM/VLM Judge routing ───────────────────────────────────────────
# Native Gemini needs only GEMINI_API_KEY above. To select it explicitly, set
# ASIBENCH_JUDGE_API_KEY_ENV=GEMINI_API_KEY and leave base/protocol empty.
#
# TokenRouter / another OpenAI-compatible gateway needs all four values below:
# TOKENROUTER_API_KEY=<secret>
# ASIBENCH_JUDGE_API_BASE=https://api.tokenrouter.com/v1
# ASIBENCH_JUDGE_API_KEY_ENV=TOKENROUTER_API_KEY
# ASIBENCH_JUDGE_API_PROTOCOL=openai
TOKENROUTER_API_KEY=
ASIBENCH_JUDGE_API_BASE=
ASIBENCH_JUDGE_API_KEY_ENV=
ASIBENCH_JUDGE_API_PROTOCOL=

# Notes:
# - claude_code_cli / codex_cli reuse your local CLI login (~/.claude, ~/.codex) first,
#   so you usually do not need to set a key here for them.
# - Some agent adapters also accept credentials in `--agent-config`. Prefer
#   provider environment variables or `api_key_env` where supported: a literal
#   `api_key` in command-line JSON may be visible in shell history/process lists.
# - `ASIBENCH_JUDGE_API_KEY_ENV` contains a variable name, never a secret. Do not
#   store Judge keys in task_eval.yaml or pass key material on the command line.
# - Judge overrides apply to `score`, `run-score`, and `benchflow-score`.
# - `run-score` keeps a dedicated nonstandard Judge key such as
#   TOKENROUTER_API_KEY out of the agent-run subprocess. Standard provider keys
#   remain shared for compatibility; use a dedicated name when isolation matters.
