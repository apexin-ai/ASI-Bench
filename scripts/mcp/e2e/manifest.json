{
  "schema_version": 1,
  "servers": [
    {
      "id": "pyscf",
      "catalog_id": "pyscf",
      "repository": "https://github.com/lixin19/mcp2pyscf.git",
      "revision": "df4ea682ec640f429015974d1daec3afa75b5142",
      "python": "3.13",
      "install": "uv-sync-frozen",
      "launch": {
        "command": ".venv/bin/python",
        "args": ["{checkout}/main.py"]
      },
      "smoke": "smoke_pyscf.py",
      "expected_tools": [
        "generate_pyscf_geom_input",
        "optimize_molecule_mcp",
        "plot_energy_scan_image_mcp",
        "pyscf_rhf_energy",
        "run_bond_stretch_calculation_mcp",
        "scan_pes_rhf",
        "visualize_molecule_3d_mcp"
      ]
    },
    {
      "id": "arxiv",
      "catalog_id": "arxiv",
      "repository": "https://github.com/mims-harvard/ToolUniverse.git",
      "revision": "9959ebee7638773314362f1746980a15f5b17e5b",
      "python": "3.12",
      "install": "uv-sync-frozen",
      "uv_sync_args": ["--no-dev"],
      "launch": {
        "command": ".venv/bin/tooluniverse-smcp-stdio",
        "args": ["--no-search", "--include-tools", "ArXiv_search_papers", "ArXiv_get_pdf_snippets"],
        "env": {
          "DO_NOT_TRACK": "1",
          "FASTMCP_CHECK_FOR_UPDATES": "off",
          "FASTMCP_SHOW_SERVER_BANNER": "false",
          "HF_HUB_OFFLINE": "1",
          "TOOLUNIVERSE_CACHE_ENABLED": "false",
          "TOOLUNIVERSE_CACHE_PERSIST": "false"
        }
      },
      "smoke": "smoke_arxiv.py",
      "expected_tools": [
        "ArXiv_get_pdf_snippets",
        "ArXiv_search_papers"
      ]
    },
    {
      "id": "jsbsim",
      "catalog_id": "jsbsim",
      "repository": "https://github.com/flyintothesky/jsbsim-mcp.git",
      "revision": "3e7f434181e926be7a9fbfaa4e387e0197968053",
      "python": "3.12",
      "install": "uv-pip-pinned",
      "requirements": ["jsbsim==1.3.1", "mcp==1.30.0", "pydantic==2.13.5"],
      "exclude_newer": "2026-10-01T00:00:00Z",
      "launch": {
        "command": ".venv/bin/python",
        "args": ["{checkout}/run_stdio.py"],
        "env": {
          "JBSIM_ROOT": "{checkout}/jsbsim_data",
          "JSBSIM_DEBUG": "0"
        }
      },
      "smoke": "smoke_jsbsim.py",
      "expected_tools": [
        "close_session",
        "create_session",
        "execute_script",
        "get_property",
        "get_telemetry",
        "list_aircraft",
        "set_initial_conditions",
        "set_property",
        "step",
        "trim"
      ]
    },
    {
      "id": "s4",
      "catalog_id": "s4",
      "repository": "https://github.com/prof-davifr/mcp-s4-rcwa.git",
      "revision": "d0b5ecd90b9f311e4ff9b30322d71485076c4eaa",
      "python": "3.12",
      "install": "uv-pip-pinned",
      "requirements": ["matplotlib==3.11.2", "mcp==1.30.0", "numpy==2.5.3", "pydantic==2.13.5"],
      "exclude_newer": "2026-10-01T00:00:00Z",
      "host_requirements": {
        "machine": ["x86_64"],
        "cpu_flags": ["avx2", "bmi2", "fma"],
        "shared_libraries": ["libblas.so.3", "liblapack.so.3"],
        "reason": "upstream vendors a prebuilt x86-64 libS4.so compiled with -march=native (AVX2/FMA/BMI2) that links the system BLAS/LAPACK; on Debian/Ubuntu an administrator installs libblas3 liblapack3"
      },
      "launch": {
        "command": ".venv/bin/python",
        "args": ["-m", "mcp_s4_rcwa.server"],
        "env": {
          "PYTHONPATH": "{checkout}/src"
        }
      },
      "smoke": "smoke_s4.py",
      "expected_tools": [
        "check_engine_sanity",
        "simulate_stack_spectrum"
      ]
    }
  ]
}
