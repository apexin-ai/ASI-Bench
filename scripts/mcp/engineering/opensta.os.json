{
  "mcpServers": {
    "opensta_native": {
      "command": "/opt/venv/bin/python",
      "args": [
        "/opt/engineering-mcp/server.py",
        "--backend",
        "opensta"
      ],
      "cwd": "/workspace",
      "env": {
        "ENGINEERING_MCP_WORKSPACE": "/workspace"
      },
      "sandbox": {
        "deployment": "instance",
        "startup_timeout_seconds": 120
      }
    }
  }
}
