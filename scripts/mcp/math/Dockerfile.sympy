FROM --platform=linux/amd64 python:3.12-slim@sha256:e8a38829209aea82774882e5157e1f7c3e8c8393ff53a697b3580896e57f345c
RUN apt-get update && apt-get install -y --no-install-recommends util-linux \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.sympy.lock /opt/math-mcp/requirements.lock
RUN python -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir --require-hashes -r /opt/math-mcp/requirements.lock
COPY runtime.py worker.py server.py healthcheck.py /opt/math-mcp/
ENV PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin HOME=/home/agent \
    MATH_MCP_WORKSPACE=/workspace MATH_PYTHON=/opt/venv/bin/python \
    MPLBACKEND=Agg OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
RUN /opt/venv/bin/python /opt/math-mcp/worker.py --probe sympy \
    && mkdir -p /workspace /home/agent/.cache /home/agent/.codex \
    && chown -R 1000:1000 /workspace /home/agent
USER 1000:1000
WORKDIR /workspace
HEALTHCHECK --interval=5s --timeout=10s --start-period=20s --retries=3 CMD ["/opt/venv/bin/python", "/opt/math-mcp/healthcheck.py"]
CMD ["/opt/venv/bin/python", "/opt/math-mcp/server.py", "--backend", "sympy"]
